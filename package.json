{
  "name": "partygameonline-platform",
  "description": "Modern real-time multiplayer tabletop & party card game web platform (BoardVerse)",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "dev:server": "powershell -ExecutionPolicy Bypass -File apps/server/run.ps1",
    "build": "npm run build --prefix apps/web",
    "typecheck": "npm run typecheck --prefix apps/web",
    "test": "npm run test --prefix apps/web",
    "test:flow": "node scripts/verify-game-flow.mjs",
    "test:browsers": "node scripts/launch-multiplayer-browsers.mjs",
    "scaffold:game": "node scripts/scaffold-game.mjs"
  }
}
